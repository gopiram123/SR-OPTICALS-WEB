rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Public catalogue: Anyone can read products, only admin can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: Anyone can read visible categories, only admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage configuration: Anyone can read, only admin can update
    match /homepage/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shop Information: Publicly readable, only admin can update
    match /shopInfo/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Anyone can read visible reviews, only admin can write/moderate
    match /reviews/{reviewId} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Store Photos gallery: Publicly readable, only admin can write
    match /storePhotos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
