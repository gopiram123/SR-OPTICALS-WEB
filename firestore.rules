rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // SR OPTICALS Security Rules
    // 1. Public Read: Any customer can view products, categories, homepage, reviews, store photos, and settings
    // 2. Authenticated Write: ANY user authenticated via Firebase Authentication can create, update, and delete
    
    // Explicit Collection Rules
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shopInfo/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /homepage/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /storePhotos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Global fallback for any nested or future collections
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
