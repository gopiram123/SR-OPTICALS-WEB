# SR OPTICALS Frontend Environment Variables

# Optional: Firebase Client credentials
# (If omitted, the frontend operates in zero-friction standalone mode with full persistence)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend REST API endpoint URL (Optional, defaults to local proxy or direct persistence)
VITE_API_BASE_URL=http://localhost:5000/api
